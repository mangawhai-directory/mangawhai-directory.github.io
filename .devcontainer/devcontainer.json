{
  "name": "Mangawhai Directory",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/hugo:1": {
      "extended": true,
      "version": "latest"
    }
  },
  "forwardPorts": [1313],
  "portsAttributes": {
    "1313": {
      "label": "Hugo dev server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "pgrep -x hugo >/dev/null || (nohup npm run dev -- --bind 0.0.0.0 </dev/null >/tmp/hugo.log 2>&1 &)",
  "remoteUser": "vscode"
}

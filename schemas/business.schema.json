{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mangawhaidirectory.co.nz/schemas/business.schema.json",
  "title": "MangawhaiDirectoryBusiness",
  "description": "Front-matter schema for content/businesses/*.md entries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "slug",
    "blurb",
    "address",
    "categories",
    "tier",
    "last_verified",
    "status"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "blurb": { "type": "string", "maxLength": 320 },
    "image": {
      "type": "string",
      "anyOf": [
        { "const": "" },
        { "pattern": "^/uploads/" },
        { "format": "uri", "pattern": "^https?://" }
      ]
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["street", "suburb", "postcode", "country"],
      "properties": {
        "street": { "type": "string", "minLength": 1 },
        "suburb": { "type": "string", "minLength": 1 },
        "postcode": { "type": "string", "pattern": "^\\d{4}$" },
        "country": { "type": "string", "enum": ["NZ"] }
      }
    },
    "geo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "phone": {
      "type": "string",
      "anyOf": [
        { "const": "" },
        { "pattern": "^\\+64\\d{8,11}$" }
      ]
    },
    "email": {
      "type": "string",
      "anyOf": [
        { "const": "" },
        { "format": "email" }
      ]
    },
    "website": {
      "type": "string",
      "anyOf": [
        { "const": "" },
        { "format": "uri", "pattern": "^https?://" }
      ]
    },
    "socials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "facebook":  { "$ref": "#/$defs/socialUrl" },
        "instagram": { "$ref": "#/$defs/socialUrl" },
        "x":         { "$ref": "#/$defs/socialUrl" },
        "linkedin":  { "$ref": "#/$defs/socialUrl" },
        "tiktok":    { "$ref": "#/$defs/socialUrl" },
        "youtube":   { "$ref": "#/$defs/socialUrl" }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "hours": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Schema.org OpeningHoursSpecification shape (subset).",
        "additionalProperties": false,
        "properties": {
          "dayOfWeek": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "opens":  { "type": "string", "anyOf": [{ "pattern": "^\\d{2}:\\d{2}$" }, { "const": "closed" }] },
          "closes": { "type": "string", "anyOf": [{ "pattern": "^\\d{2}:\\d{2}$" }, { "const": "" }] },
          "validFrom":   { "type": "string", "format": "date" },
          "validThrough": { "type": "string", "format": "date" }
        }
      }
    },
    "nzbn": {
      "type": "string",
      "anyOf": [
        { "const": "" },
        { "pattern": "^\\d{13}$" }
      ]
    },
    "logo": { "type": "string" },
    "featured": { "type": "boolean" },
    "tier": { "type": "string", "enum": ["free", "paid"] },
    "last_verified": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["active", "closed", "pending"] }
  },
  "$defs": {
    "socialUrl": {
      "type": "string",
      "anyOf": [
        { "const": "" },
        { "format": "uri", "pattern": "^https?://" }
      ]
    }
  }
}
